# Safe defaults: paper-only mode and loopback dashboard.
BIND_ADDR=127.0.0.1:8080
RUN_MODE=shadow
RUST_LOG=info

# Paper strategy and evaluation buffers.
DRY_RUN_STRATEGY=hold_sharp
TRADE_SIZE_USD=2
MIN_PROFIT_BUFFER=0.10
LATENCY_EDGE_BUFFER=0.02
ENABLE_ALPHA_TILT_DRY_RUN=false

# Market-data settings. RTDS is the default public reference source.
USE_CHAINLINK_STREAMS=false
ALLOW_RTDS_SHADOW_FALLBACK=true
BTC_FEED_ID=
CHAINLINK_STREAMS_CLIENT_ID=
CHAINLINK_STREAMS_SECRET=

# Optional authenticated dashboard controls. Generate with: openssl rand -hex 32
CONTROL_TOKEN=
